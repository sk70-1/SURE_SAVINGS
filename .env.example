# Environment Configuration for Smart Income Buffer

# Application
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Default to SQLite for zero-setup local dev; switch to PostgreSQL in production/staging
DATABASE_URL=sqlite:///./smart_buffer.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_income_buffer

# Security
SECRET_KEY=dev_secret_key_smart_income_buffer_super_secure_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Explanation Layer
# Optional: GEMINI_API_KEY or OPENAI_API_KEY for live external LLM calls.
# If omitted or unavailable, backend provides deterministic grounded explanations using facts.
AI_PROVIDER=deterministic_mock
AI_API_KEY=
