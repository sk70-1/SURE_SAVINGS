# Environment Configuration for Sure-Savings Platform

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database Configuration
# In Production/Staging: PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sure_savings
# In Local Development: Canonical SQLite path (defaults automatically to apps/api/smart_buffer.db if unset)
# DATABASE_URL=sqlite:///apps/api/smart_buffer.db

# Security & JWT Authentication
# In production, SECRET_KEY must be a cryptographically secure random string with minimum 32 characters.
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Mode Sandbox:
# Disabled by default. Strictly forbidden in production.
DEMO_MODE_ENABLED=false

# AI Explanation Layer
AI_PROVIDER=deterministic_mock
AI_API_KEY=
