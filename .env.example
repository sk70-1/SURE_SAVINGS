# Environment Configuration for Sure-Savings Platform

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database Configuration
# In Production/Staging: PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sure_savings
# In Local Development: SQLite canonical database file
DATABASE_URL=sqlite:///./smart_buffer.db

# Security & JWT Authentication
SECRET_KEY=sure_savings_dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Mode Sandbox:
# When true, allows switching to synthetic personas in demo sandbox mode.
# When false, strictly enforces real authentication for all endpoints.
DEMO_MODE_ENABLED=true

# AI Explanation Layer
AI_PROVIDER=deterministic_mock
AI_API_KEY=
